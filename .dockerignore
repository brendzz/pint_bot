# Secrets — never bake into images
*.env
.env
.env.*
**/.env
**/.env.*
secrets.dev.yaml
values.dev.yaml

# Runtime data (debts, transactions, preferences, backups)
data/
api/data/
**/data/*.json
**/data/*.bak
**/data/*.tmp

# VCS & CI
.git
.github
.gitignore
.dockerignore

# Python artifacts
__pycache__/
*.py[cod]
*.so
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Virtualenvs
.venv/
venv/

# Editor & OS files
*.log
.DS_Store
Thumbs.db
.vscode/
.vs/
.sonar/

# IDE/project files
.classpath
.project
.settings
.toolstarget
*.*proj.user
*.dbmdl
*.jfm

# Node/npm
node_modules/
npm-debug.log

# Build output
bin/
obj/
charts/

# Tests (not needed at runtime)
tests/
