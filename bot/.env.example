# Add your bot token here from the Discord Developer Portal
BOT_TOKEN="YOUR_BOT_TOKEN"

# Set the url for your pint bot api here
API_URL="http://api:8000"

# Which chat platform to run: "discord" (only supported platform so far).
# To add another, see docs/ADDING_A_PLATFORM.md.
PLATFORM="discord"

# Optional: Discord channel webhook URL for the API audit log.
# Set this on the API service (not the bot) if you want one message per transaction.
# AUDIT_LOG_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Optional but recommended: the API key the API expects in the X-API-Key header.
# Must match the API_KEY set on the API service. Leave unset to disable auth.
API_KEY=""
